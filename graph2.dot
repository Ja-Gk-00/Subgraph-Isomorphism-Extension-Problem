graph G {
  node [shape=circle];
  0 [label="0", style=filled, fillcolor="yellow"];
  1 [label="1", style=filled, fillcolor="yellow"];
  2 [label="2", style=filled, fillcolor="yellow"];
  3 [label="3", style=filled, fillcolor="yellow"];
  4 [label="4"];
  5 [label="5"];
  0 -- 1 [label="1", color="red"];
  0 -- 2 [label="1", color="red"];
  0 -- 3 [label="1", color="red"];
  1 -- 2 [label="1", color="red"];
  1 -- 3 [label="1", color="red"];
  1 -- 4 [label="1", color="black"];
  2 -- 3 [label="1", color="red"];
  2 -- 5 [label="1", color="black"];
  4 -- 5 [label="1", color="black"];
}
